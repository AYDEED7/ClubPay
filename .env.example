# Copy this file to .env and fill in the values. Never commit .env.

# Gemini API key, free from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the model (default: gemini-3.5-flash)
# GEMINI_MODEL=gemini-3.5-flash

# PayPal SANDBOX app credentials (developer.paypal.com -> Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Optional: webhook ID from the PayPal app's Webhooks section.
# Point the webhook at https://<your-host>/api/webhooks/paypal
PAYPAL_WEBHOOK_ID=

PORT=3001
