              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "invoices",
                "remind"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Friendly reminder that this club payment is still open.\"\n}"
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "Assistant",
      "item": [
        {
          "name": "Ask the treasurer assistant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/agent",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "agent"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"How much have we spent on food so far?\"\n    }\n  ]\n}"
            },
            "description": "Gemini function calling over the ledger and PayPal."
          }
        }
      ]
    },
    {
      "name": "PayPal",
      "item": [
        {
          "name": "Sync statuses with PayPal",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sync",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sync"
              ]
            },
            "description": "Pulls the latest payout and invoice statuses."
          }
        },
        {
          "name": "Webhook receiver",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/paypal",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "webhooks",
                "paypal"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_type\": \"PAYMENT.PAYOUTS-ITEM.SUCCEEDED\"\n}"
            },
            "description": "Called by PayPal. Requests without a valid PayPal signature get 400."
          }
        }
      ]
    },
