{
  "info": {
    "name": "ClubPay API",
    "description": "Every endpoint of ClubPay, the AI treasurer for student clubs. Set the baseUrl variable to http://localhost:3001 for local runs or to the live demo URL. All PayPal calls behind these endpoints go to the PayPal sandbox.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://clubpay-8q3f.onrender.com"
    },
    {
      "key": "reimbursementId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Status",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": "Shows whether Gemini, PayPal and the webhook ID are configured."
          }
        },
        {
          "name": "Overview",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/overview",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "overview"
              ]
            },
            "description": "Club settings, budgets, members, totals and recent activity."
          }
        }
      ]
    },
    {
      "name": "Reimbursements",
      "item": [
        {
          "name": "List reimbursements",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reimbursements",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reimbursements"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Submit a receipt for AI review",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reimbursements",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reimbursements"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "receipt",
                  "type": "file",
                  "src": ""
                },
                {
                  "key": "memberId",
                  "type": "text",
                  "value": "1"
                },
                {
                  "key": "note",
                  "type": "text",
                  "value": "Pizza for Thursday build night"
                }
              ]
            },
            "description": "Uploads a receipt image or PDF. Gemini extracts the fields and checks them against the club policy."
          }
        },
        {
          "name": "Approve and pay (PayPal Payout)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reimbursements/{{reimbursementId}}/approve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reimbursements",
                "{{reimbursementId}}",
                "approve"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 51.25\n}"
            },
            "description": "Human approval. Sends a PayPal sandbox payout to the member."
          }
        },
        {
          "name": "Reject",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reimbursements/{{reimbursementId}}/reject",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reimbursements",
                "{{reimbursementId}}",
                "reject"
              ]
            },
            "description": ""
          }
        }
      ]
    },
    {
